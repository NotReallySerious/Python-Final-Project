<+>// IMPORT PYTHON LIBRARIES\r\nIMPORT base64\r\nIMPORT codecs\r\nIMPORT hashlib\r\nIMPORT datetime as dt\r\nfrom pharmacist.pharmacist import pharmasist\r\nfrom accountant.account__assistant import accountant_main, delete_receipt, user_total_details, get_receipt_list\r\n\r\nFUNCTION encrypt_password(password):\r\n\r\n    // change the password string into base64\r\n\r\n    SET password_bytes = CONVERT password string to utf-8\r\n    SET base64_encoded = ENCODE password_bytes into base64 using base64 algorithm\r\n    SET base64_string = DECODE base64_encoded into utf-8\r\n\r\n    // encode the base64 string to rot-13\r\n    SET ROT_13_encode = ENCODE base64_string to ROT-13\r\n\r\n    // encode the ROT-13 String to SHA256\r\n    SET hash_bytes = CONVERT ROT_13_encode string into utf-8 string\r\n    SET sha256_string = HASH hash_bytes into SHA256 HASH STRING \r\n    SET final_hex_representation = CONVERT sha256_string into HEX STRING\r\n    DISPLAY final_hex_representation\r\n\r\nENDFUNCTION\r\n\r\nFUNCTION register():\r\n    WHILE True DO\r\n        PROMPT USER TO ENTER THEIR EMAIL ADDRESS (user_email)\r\n\r\n        IF user_email NOT CONTAIN '@' THEN\r\n            DISPLAY 'Invalid Email'\r\n        ELSE\r\n            BREAK LOOP\r\n        ENDIF\r\n    ENDWHILE\r\n\r\n    SET email_domain to python list ['aphdoctor.aph.com','aphaccountant.aph.com','aphreceptionist.aph.com','aphpharmacist.aph.com','aphhadmin.aph.com']\r\n    TRY:\r\n        SET domain = split by '@', take the first index of user_email\r\n    \r\n        IF domain == email_domain[0]\r\n            SET role = 'Doctor'\r\n        ELSE IF domain == email_domain[1]\r\n            SET role = 'accountant'\r\n        ELSE IF domain == email_domain[2]\r\n            SET role = 'receptionist'\r\n        ELSE IF domain == email_domain[3]\r\n            SET role = 'pharmacist'\r\n        ELSE IF domain == email_domain[4]\r\n            SET role = 'administrator'\r\n        ELSE\r\n            SET role = 'patient'\r\n        ENDIF\r\n    \r\n    CATCH IndexError:\r\n        DISPLAY 'invalid email format'\r\n\r\n    ENDTRY\r\n    \r\n    PROMPT USER FOR USERNAME (trim whitespaces, replace space between characters to '_')\r\n\r\n    WHILE True DO\r\n        PROMPT USER FOR PASSWORD (password) (trim whitespaces)\r\n        \r\n        SET password_length = length of password\r\n        SET uppercase_count = 0\r\n        SET lowercase_count = 0\r\n        SET num_count = 0 \r\n        SET special_characters TO PYTHON LIST ['[','!','@','#','$','%','^','&','*','(',')','.','?','\"',':','{','}','|','<','>',']']\r\n        SET special_count = 0\r\n        SET all_valid = True\r\n\r\n        IF password_length < 12:\r\n            DISPLAY \"your password length is {password_length}. you password must have at least 12 characters\"\r\n            SET all_valid = False\r\n        ENDIF\r\n\r\n        FOR every letter in password DO\r\n            IF letter is uppercase DO\r\n                INCREMENT uppercase_count by 1\r\n            ELSE IF letter is lowercase DO\r\n                INCREMENT lowercase_count by 1\r\n            ENDIF\r\n            IF letter is numeric DO\r\n                INCREMENT num_count by 1\r\n            ENDIF\r\n        ENDFOR\r\n        \r\n        IF uppercase_count < 1 DO \r\n            DISPLAY 'your password must have at least 1 uppercase letter'\r\n            SET all_valid = False\r\n        ENDIF\r\n\r\n        IF lowercase_count < 1 DO\r\n            DISPLAY 'Your password must have at least 1 lowercase character'\r\n            SET all_valid = False\r\n        ENDIF\r\n\r\n        FOR every letter in password\r\n            IF letter is a special character DO\r\n                INCREMENT special_count by 1\r\n            ENDIF\r\n        ENDFOR\r\n\r\n        IF special_count < 1 DO\r\n            DISPLAY 'Your password must have at least 1 special characters'\r\n            SET all_valid = False\r\n        ENDIF\r\n\r\n        IF num_count < 1 DO\r\n            DISPLAY 'Your password must have at least 1 digit number'\r\n            SET all_valid = False\r\n        ENDIF\r\n\r\n        IF all_valid IS True DO \r\n            DISPLAY 'Password all match'\r\n            SET encrypted_pass = encrypt_password(password) \r\n            EXIT LOOP\r\n        ENDIF\r\n    ENDWHILE\r\n    \r\n    DISPLAY 'username: {username}, email: {user_email}, Password: {encrypted_pass} Role: {role}'\r\n\r\n    TRY:\r\n        OPEN login/user_db.txt FOR APPENDING AS f\r\n            WRITE '{username},{user_email},{password},{role}' + new line to f\r\n            DISPLAY 'User Registered succesfully'\r\n        CLOSE f\r\n    CATCH FileNotFoundError AS e:\r\n        DISPLAY 'Error: {e}'\r\n    END TRY\r\n    \r\n    TRY:\r\n        OPEN login/user_db_encrypted.txt FOR APPENDING AS fe\r\n            WRITE '{username},{user_email},{encrypt_password(password)},{role}' + new line TO fe\r\n        CLOSE fe\r\n    CATCH FileNotFoundError as e:\r\n        DISPLAY 'Error: {e}'\r\n    END TRY\r\nEND FUNCTION\r\n\r\nFUNCTION login():\r\n    SET wrong_attempt_count = 3\r\n\r\n    WHILE wrong_attempt_count NOT 0 DO \r\n\r\n        PROMPT USER TO ENTER THEIR EMAIL ADDRESS (email) (trim whitespaces)\r\n        PROMPT USER TO ENTER THEIR PASSWORD (password) (trim whitespaces)\r\n        SET enc_password = encrypt_password(password)\r\n        SET valid_user = False\r\n\r\n        OPEN login/user_db_encrypted.txt FOR READING as f\r\n            SET lines = read all lines from f\r\n\r\n            FOR EVERY line IN lines DO\r\n                SET fields = trim whitespaces, and split by comma\r\n                EXTRACT username FROM fields[0] (remove quotes)\r\n                EXTRACT file_email FROM fields[1] (remove quotes)\r\n                EXTRACT file_password FROM fields[2] (remove quotes)\r\n                EXTRACT user_role FROM fields[3] (remove quotes)\r\n            ENDFOR\r\n\r\n            IF valid_user IS True THEN\r\n                OPEN login/clocked_in.txt FOR APPENDING as cl\r\n                    GET current timestamp\r\n                    WRITE '{current timestamp}: {user_role}, {username}' + add new line TO cl\r\n                CLOSE FILE\r\n                DISPLAY 'Hello {user_role}, {username}' + add new line\r\n\r\n                IF user_role is 'Doctor' THEN\r\n                    DISPLAY 'Hello Doctor {username}'\r\n                    RETURN from FUNCTION\r\n            \r\n               ELSE IF user_role is 'accountant' THEN\r\n                    DISPLAY 'Hello accountant {username}, ready to count some money?'\r\n                    RETURN from FUNCTION\r\n\r\n                ELSE IF user_role is 'pharmacist' THEN\r\n                    DISPLAY 'Hello pharmacist {username}'\r\n                    RETURN from FUNCTION\r\n\r\n                ELSE IF user_role is 'receptionist' THEN\r\n                    DISPLAY 'Catchingg... Hello {username}'\r\n                    RETURN from FUNCTION\r\n\r\n                ELSE IF user_role is 'Administrator' THEN\r\n                    DISPLAY 'Hello Admin. lets go manage some stuffs today'\r\n                    RETURN from FUNCTION\r\n                \r\n                ELSE\r\n                    DISPLAY 'No role for you. Do you even work here?'\r\n                    BREAK \r\n                ENDIF\r\n            ELSE\r\n                DECREMENT wrong_attempt_count by 1\r\n                DISPLAY 'credentials invalid. you have {wrong_attempt_count} attempt(S) left'\r\n            ENDIF\r\n        CLOSE FILE\r\n    DISPLAY 'hacker detected, go away'\r\nEND FUNCTION\r\n\r\nFUNCTION main():\r\n    WHILE True DO\r\n        DISPLAY 'Asia Pacific Hospital HealthPlus patient management'\r\n        DISPLAY '1. Register'\r\n        DISPLAY '2. Login'\r\n        DISPLAY '3. Exit'\r\n        PROMPT USER TO ENTER THEIR OPTION AND CONVERT TO INTEGER (choice)\r\n        CASE OF choice \r\n            1: JUMP TO FUNCTION register()\r\n            2: JUMP TO FUNCTION login()\r\n            3: BREAK \r\n        ENDCASE\r\n    ENDWHILE\r\nENDFUNCTION\r\n\r\n\r\n\r\n\r\n    \r\n\r\n            \r\n    
